# Шаблон конфигурации для запуска сервера внутри Docker Compose (профиль app).
# Скопируйте в backend/.env.docker и скорректируйте секреты при необходимости.
DATABASE_URL=postgres://volontiers:volontiers_dev@db:5432/volontiers
BIND=0.0.0.0:8080
APP_ENV=development
# ≥ 32 символов (для production сгенерировать: openssl rand -hex 32)
JWT_SECRET=dev-docker-jwt-secret-at-least-32-chars-long
# Мастер-ключ шифрования ПДн (AES-256-GCM, 64 hex-символа = 32 байта)
DATA_ENCRYPTION_KEY=04608cc1e69c7d7900e7b6a397a1a887f7dee51e344d0f6fd0d127711cf00151
SESSION_HOURS=24
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
STATIC_DIR=/app/dist
PUBLIC_MARKER_PHOTOS=true
TRUST_PROXY=true
RUN_MIGRATIONS=true
RUST_LOG=info,sqlx=warn

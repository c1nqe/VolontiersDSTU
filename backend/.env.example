# Скопируйте в backend/.env и поправьте значения.
DATABASE_URL=postgres://volontiers:volontiers_dev@127.0.0.1:5432/volontiers
BIND=127.0.0.1:8080
# development | production
APP_ENV=development
# ≥ 32 символов. В production обязателен. Сгенерировать: openssl rand -hex 32
JWT_SECRET=
SESSION_HOURS=24
# Источники, которым разрешено слать запросы с cookie (через запятую). По умолчанию — dev-адреса Vite (порт 3000).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Раздача собранного фронтенда этим же сервером: каталог dist после `npm run build`
STATIC_DIR=../dist
# Фото меток ПСО видны гостям (true) или только вошедшим (false)
PUBLIC_MARKER_PHOTOS=true
# true — если сервер стоит за reverse proxy (берёт IP из X-Forwarded-For для лимитов)
TRUST_PROXY=false
# В production миграции выполняет роль-владелец командой `migrate`, а сервер запускается с RUN_MIGRATIONS=false
RUN_MIGRATIONS=true
RUST_LOG=info,sqlx=warn

# ---- Почта (подтверждение адреса и восстановление пароля) ----
# Без SMTP_HOST письма не отправляются, «Забыли пароль?» отвечает, что сервис не настроен.
# SMTP_HOST=smtp.donstu.ru
# starttls — порт 587 (по умолчанию), tls — порт 465, none — без шифрования (только для локального теста, в production запрещено)
# SMTP_TLS=starttls
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# Адрес отправителя; допустим формат: Волонтёры ДГТУ <noreply@donstu.ru>
# SMTP_FROM=Волонтёры ДГТУ <noreply@donstu.ru>
# Адрес сайта для ссылок в письмах (в production обязателен вместе с SMTP_HOST)
# PUBLIC_URL=https://volunteers.donstu.ru
# true — без подтверждённой почты нельзя создавать события, заявки и метки (требует SMTP)
# REQUIRE_VERIFIED_EMAIL=false
